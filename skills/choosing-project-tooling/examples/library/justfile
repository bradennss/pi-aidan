check:
    pnpm exec prettier --check .
    pnpm exec eslint . --max-warnings 0
    pnpm exec tsc --noEmit
    pnpm exec vitest run
    node --test scripts/*.test.mjs
    actionlint .github/workflows/*.yml

format:
    pnpm exec prettier --write .

build:
    pnpm exec tsdown

pack: build
    mkdir -p .artifacts
    pnpm pack --out .artifacts/package.tgz

test-consumer: pack test-packed

# Verify an existing artifact without building or packing it again.
test-packed:
    #!/usr/bin/env bash
    set -euo pipefail
    artifact="$PWD/.artifacts/package.tgz"
    pnpm exec publint "$artifact" --strict
    pnpm exec attw "$artifact" --profile esm-only
    consumer="$(mktemp -d "${TMPDIR:-/tmp}/duration-consumer.XXXXXX")"
    trap 'rm -rf "$consumer"' EXIT
    cp test/consumer/{package.json,tsconfig.json,index.ts} "$consumer/"
    cd "$consumer"
    unset NODE_PATH
    pnpm add --save-exact "$artifact"
    pnpm exec tsc
    node dist/index.js

# Only the credential-free check job, never release.yml.
ci-test:
    act pull_request --workflows .github/workflows/check.yml --job check --secret-file /dev/null --var-file /dev/null --env-file /dev/null --input-file /dev/null

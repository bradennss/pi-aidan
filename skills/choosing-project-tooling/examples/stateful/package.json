{
  "name": "stateful-task-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src/tasks/service.test.ts test/migration.test.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
    "build": "next build",
    "db-generate": "drizzle-kit generate",
    "db-migrate": "drizzle-kit migrate",
    "test-integration": "vitest run test/persistence.test.ts && playwright test --project=integration",
    "test-browser": "playwright test --project=desktop --project=mobile"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "drizzle-orm": "0.45.4",
    "motion": "14.9.1",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

# All credentials and ports here are disposable local fixtures, never production.
dev_database := "postgresql://stateful_local:disposable-local-only@127.0.0.1:55432/stateful_dev"
test_database := "postgresql://stateful_local:disposable-local-only@127.0.0.1:55433/stateful_test"

default:
    @just --list

install:
    pnpm install --frozen-lockfile

db-up:
    docker compose --project-name stateful-task-tracker --file compose.yml up -d --wait --wait-timeout 60 db

dev: db-up db-migrate
    DATABASE_URL='{{dev_database}}' pnpm run dev

# Production migrations require an explicitly supplied DATABASE_URL.
db-migrate:
    DATABASE_URL="${DATABASE_URL:-{{dev_database}}}" pnpm run db-migrate

db-generate:
    DATABASE_URL='{{dev_database}}' pnpm run db-generate

test-db-up:
    docker compose --project-name stateful-task-tracker --file compose.yml up -d --wait --wait-timeout 60 test-db

check: test-db-up
    DATABASE_URL='{{test_database}}' pnpm run check

format:
    pnpm run format

build:
    pnpm run build

install-browser:
    pnpm exec playwright install chromium

# Real PostgreSQL service tests migrate their own guarded test database.
test-integration: test-db-up
    DATABASE_URL='{{test_database}}' pnpm exec vitest run test/migration.test.ts test/persistence.test.ts
    docker compose --project-name stateful-task-tracker --file compose.yml up -d --build --force-recreate --wait --wait-timeout 90 app gateway
    DATABASE_URL='{{test_database}}' pnpm exec playwright test --project=integration

test-browser: test-db-up
    DATABASE_URL='{{test_database}}' pnpm run db-migrate
    docker compose --project-name stateful-task-tracker --file compose.yml up -d --build --force-recreate --wait --wait-timeout 90 app gateway
    DATABASE_URL='{{test_database}}' pnpm run test-browser

# Stops this example's services only; volumes and tasks are retained.
stop:
    docker compose --project-name stateful-task-tracker --file compose.yml --profile test down

infra-validate:
    tofu -chdir=infra fmt -check
    TF_VAR_state_passphrase=local-validation-only-not-a-production-key tofu -chdir=infra init -backend=false -input=false -lockfile=readonly
    TF_VAR_state_passphrase=local-validation-only-not-a-production-key tofu -chdir=infra validate

# Read-only production planning still needs authorized credentials and current state.
infra-plan:
    sops exec-env secrets/state.enc.yaml 'sops exec-env secrets/infra.enc.yaml "tofu -chdir=infra init -input=false -lockfile=readonly && tofu -chdir=infra plan -input=false"'

# Only native-encrypted state may be persisted or uploaded.
verify-state:
    jq -e 'keys == ["encrypted_data", "encryption_version", "lineage", "meta", "serial"] and (.encrypted_data | type == "string" and length > 0)' infra/production.tfstate >/dev/null
    tofu -chdir=infra state pull >/dev/null

# CI state writer. Retain verified ciphertext before committing; never rebase state.
persist-state: verify-state
    mkdir -p .recovery
    cp infra/production.tfstate .recovery/production.tfstate
    git add -- infra/production.tfstate
    if ! git diff --cached --quiet -- infra/production.tfstate; then \
        git -c user.name='Infrastructure state' -c user.email='infra@users.noreply.github.com' commit --only -m 'Persist encrypted infrastructure state [skip ci]' -- infra/production.tfstate && \
        git push origin HEAD:main; \
    fi

install-host:
    cd ansible && ansible-galaxy collection install -r requirements.yml -p collections

host-check:
    cd ansible && ansible-playbook --syntax-check playbook.yml

ci-test:
    act push -W .github/workflows/check.yml -j check --secret-file /dev/null --var-file /dev/null --env-file /dev/null --input-file /dev/null

# Local-only failure/recovery rehearsal. Creates no cloud resources.
test-operations:
    node --test ops/operations.test.mjs

# Remote mutation. Suspend CI and obtain authorization before operator deployment.
[positional-arguments]
deploy revision:
    #!/usr/bin/env bash
    set -euo pipefail
    test "${DEPLOY_AUTHORIZED:-}" = true
    export REVISION="$1"
    printf '%s' "$REVISION" | grep -Eq '^[0-9a-f]{40}$'
    sops exec-env secrets/deploy.enc.yaml 'kamal deploy --skip-push --version="$REVISION"'

# Local disposable backup/restore and failed-release rehearsal, not R2/Kamal verification.
test-recovery:
    node --test ops/recovery.test.mjs

# Only disposable local captures. Production uses database-backup.service.
backup:
    #!/usr/bin/env bash
    set -euo pipefail
    name="${BACKUP_DATABASE:-stateful_test}"
    [[ "$name" =~ ^stateful_(test|backup_[a-z0-9_]+)$ ]]
    umask 077
    dump=$(mktemp -d)
    trap 'rm -rf "$dump"' EXIT
    docker compose exec -T test-db pg_dump -U stateful_local -d "$name" --format=custom --no-owner --no-privileges > "$dump/tasks.dump"
    (cd "$dump" && restic backup tasks.dump --tag stateful-postgres --host stateful-local)

# CREATEDB refuses existing targets; never restores production or over existing data.
[positional-arguments]
restore database_url:
    #!/usr/bin/env bash
    set -euo pipefail
    url="$1"
    [[ "$url" =~ ^postgresql://stateful_local:disposable-local-only@127\.0\.0\.1:55433/(stateful_restore_[a-z0-9_]+)$ ]]
    name="${BASH_REMATCH[1]}"
    umask 077
    dump=$(mktemp -d)
    trap 'rm -rf "$dump"' EXIT
    restic dump --tag stateful-postgres --host stateful-local latest tasks.dump > "$dump/tasks.dump"
    docker compose exec -T test-db createdb -U stateful_local "$name"
    docker compose exec -T test-db pg_restore -U stateful_local -d "$name" --exit-on-error --no-owner --no-privileges < "$dump/tasks.dump"

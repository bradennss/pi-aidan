FROM golang:1.27.3-trixie AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /out/api ./cmd/api && \
    CGO_ENABLED=0 go build -o /out/worker ./cmd/worker
RUN GOBIN=/out CGO_ENABLED=0 go install -tags='no_clickhouse,no_mssql,no_mysql,no_sqlite3,no_vertica,no_ydb' github.com/pressly/goose/v3/cmd/goose@v3.29.0 && \
    GOBIN=/out CGO_ENABLED=0 go install github.com/riverqueue/river/cmd/river@v0.51.1

FROM debian:trixie-slim AS runtime
COPY --from=build /out/ /usr/local/bin/
COPY db/migrations /migrations
USER 65532:65532
CMD ["api"]

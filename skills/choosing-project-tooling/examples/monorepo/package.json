{
  "name": "report-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @reports/web dev",
    "check": "pnpm --filter @reports/web check && tsc --noEmit && eslint playwright.config.ts test/browser.spec.ts --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "build": "pnpm --filter @reports/web build",
    "test-browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}

[Unit]
Description=Minecraft-aware encrypted off-host backup
Requires=docker.service
After=docker.service network-online.target
OnFailure=minecraft-alert.service

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=/etc/minecraft/backup.env
RuntimeDirectory=minecraft-backup
RuntimeDirectoryMode=0700
TimeoutStartSec=1h
# .paused bypasses upstream save coordination and is never allowed on real data.
ExecStartPre=/usr/bin/test ! -e /srv/minecraft/worlds/primary/.paused
ExecStartPre=/usr/bin/touch /run/minecraft-backup/started
ExecStart=/usr/bin/docker compose --env-file /dev/null -f /etc/minecraft/backup.compose.yml run --name minecraft-backup-once --rm --no-deps -T backup
# Compare UTC timestamps at the marker's whole-second precision, not as strings.
# Round-trip validation rejects malformed dates before retention.
ExecStart=/bin/bash -eu -o pipefail -c 'since=$$(date -u -r /run/minecraft-backup/started +%%s); restic snapshots --json --latest 1 --host minecraft-production --tag minecraft-data,minecraft --path /data | jq -e --argjson since "$$since" "length == 1 and (.[0].time | sub(\\"[.][0-9]+Z$$\\"; \\"Z\\") | . as \\$$stamp | fromdateiso8601 as \\$$seconds | select((\\$$seconds | todateiso8601) == \\$$stamp) | \\$$seconds >= \\$$since)" >/dev/null'
ExecStart=/usr/bin/restic check
ExecStart=/usr/bin/restic forget --host minecraft-production --tag minecraft-data,minecraft --path /data --keep-daily 7 --keep-weekly 5 --keep-monthly 12 --keep-tag keep --prune
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/cache/minecraft-restic
Environment=RESTIC_CACHE_DIR=/var/cache/minecraft-restic

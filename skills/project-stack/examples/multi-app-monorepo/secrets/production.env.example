# Encrypt as secrets/production.enc.env with SOPS.
# Store its age private key in the production GitHub environment secret SOPS_AGE_KEY.
# Set SSH_PRIVATE_KEY in that environment to an unencrypted Ed25519 deployment key.
# Generate a key with ssh-keygen -t ed25519 -N '' -f production_key.
# Install its public key for the Debian bootstrap user on the target VPS.
# Store a VPS_IP ssh-ed25519 BASE64 entry in the GitHub environment secret SSH_KNOWN_HOSTS.
# Obtain that host public key from /etc/ssh/ssh_host_ed25519_key.pub through the VPS console.

# Create a Debian 13 VPS first. Both environments may use the same service name.
TF_VAR_ovh_endpoint=ovh-us
TF_VAR_vps_service_name=vps-123456.ovh.net
# Copy production_key.pub here without quotes; SOPS preserves spaces and quotes literally.
TF_VAR_vps_public_key=
TF_VAR_cloudflare_zone_id=

# Generate a different passphrase for each environment with openssl rand -hex 32.
TF_VAR_state_passphrase=

# OVH (US): https://api.us.ovhcloud.com/createToken/
# Grant GET /auth/details and GET /vps/*, scoped to this VPS's service name.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Cloudflare: https://dash.cloudflare.com/profile/api-tokens > Create Token > Custom token.
# Grant Zone > DNS > Edit for this environment's zone.
# In Cloudflare, set SSL/TLS to Full (strict), minimum TLS to 1.2, and Always Use HTTPS to off.
CLOUDFLARE_API_TOKEN=

# Choose unique hostnames for this environment, even when sharing a VPS.
API_HOST=api.example.com
WEB_HOST=notes.example.com
API_URL=https://api.example.com

# After DEPLOY_ENV=production just infra, read values with DEPLOY_ENV=production just infra-output.
# Copy vps_ip.value to VPS_IP and runtime.value credentials to the remaining settings.
# Keep generated credentials unchanged during normal deployments.
VPS_IP=
DATABASE_URL=
API_TOKEN=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

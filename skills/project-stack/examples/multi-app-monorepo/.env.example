# Local development/test values; production app credentials come from OpenTofu.
POSTGRES_PASSWORD=local-admin-only
APP_DB_PASSWORD=local-app-only
API_TOKEN=localDevelopmentToken000000000000000000
DATABASE_URL=postgres://postgres:local-admin-only@127.0.0.1:5432/postgres

# Run age-keygen and paste its "AGE-SECRET-KEY-..." line.
# CI uses the SOPS_AGE_KEY GitHub environment secret.
SOPS_AGE_KEY=

# Local Kamal setup/deploy only; CI supplies registry credentials automatically.
# Set REGISTRY_NAMESPACE to the GitHub user or organization that owns the images.
REGISTRY_NAMESPACE=
REGISTRY_USER=
KAMAL_REGISTRY_PASSWORD=

set dotenv-load
set shell := ["bash", "-euo", "pipefail", "-c"]

with_deployment_secrets := "sops exec-env secrets/deployment.enc.env"

default:
    @just --list

up:
    docker compose up --build -d --wait

down:
    docker compose down

format:
    cargo fmt
    tofu -chdir=infra fmt -recursive
    prettier --write "**/*.{md,yml,json,mjs}"

check:
    cargo fmt --check
    cargo clippy --locked --all-targets -- -D warnings
    cargo test --locked
    prettier --check "**/*.{md,yml,json,mjs}"
    tofu -chdir=infra fmt -check -recursive
    tofu -chdir=infra init -backend=false -input=false -lockfile=readonly
    tofu -chdir=infra validate
    ansible-playbook -i localhost, ansible/playbook.yml --syntax-check
    actionlint .github/workflows/*.yml
    shellcheck scripts/*.sh
    docker compose config --quiet

ansible-deps:
    ansible-galaxy collection install -r ansible/requirements.yml

ci-local:
    act push -W .github/workflows/ci.yml -j check --container-architecture linux/amd64

infra:
    {{with_deployment_secrets}} 'bash scripts/infra.sh'

deploy:
    {{with_deployment_secrets}} 'bash scripts/deploy.sh'

# Encrypt as secrets/production.enc.env with SOPS.

# Generate the state passphrase once with openssl rand -hex 32.
TF_VAR_state_passphrase=

# OVH (US): https://api.us.ovhcloud.com/createToken/
# Add these method/path pairs under Rights (no /1.0 prefix or query strings):
# GET  /auth/details
# GET  /me/payment/method
# GET  /me/order/*/status
# GET  /me/order/*/details
# GET  /me/order/*/details/*/operations
# GET  /me/order/*/details/*/operations/*
# GET  /vps/*
# PUT  /vps/*
# POST /order/cart
# POST /order/cart/*/assign
# POST /order/cart/*/vps
# POST /order/cart/*/item/*/configuration
# POST /order/cart/*/checkout
# POST /me/order/*/pay
# GET /vps/* includes IP/datacenter reads. No rebuild or termination rights are needed.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Cloudflare: https://dash.cloudflare.com/profile/api-tokens > Create Token > Custom token.
# Grant Zone > DNS > Edit and Zone > Zone Settings > Edit, scoped to the app's zone.
CLOUDFLARE_API_TOKEN=

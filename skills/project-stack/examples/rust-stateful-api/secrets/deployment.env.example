# Encrypt as secrets/deployment.enc.env with SOPS.
# Store its age private key in the repository Actions secret SOPS_AGE_KEY.
# Store an unencrypted Ed25519 deployment private key in SSH_PRIVATE_KEY.
# Generate it with ssh-keygen -t ed25519 -N '' -f deploy_key.
# Create a dedicated OVH VPS first and copy its service name below.
# CI imports and reinstalls it, then hardens it with Ansible.
# The initial apply erases the VPS. Changing its image UUID or SSH key also erases its data.
# Keep the SSH key and image UUID stable during normal deployments.

# Choose account values as in infra/terraform.tfvars.example.
TF_VAR_ovh_endpoint=ovh-us
TF_VAR_vps_service_name=vps-123456.ovh.net
# Find the Debian 13 UUID using GET /vps/{serviceName}/images/available and /images/available/{id}.
# The API console is https://api.us.ovhcloud.com/console/.
TF_VAR_vps_image_id=
TF_VAR_cloudflare_zone_id=
TF_VAR_staging_host=staging-api.example.com
TF_VAR_production_host=api.example.com

# Generate the state passphrase once with openssl rand -hex 32.
TF_VAR_state_passphrase=

# OVH (US): https://api.us.ovhcloud.com/createToken/
# Add these method/path pairs under Rights (no /1.0 prefix or query strings):
# GET  /auth/details
# GET  /vps/*
# PUT  /vps/*
# POST /vps/*/rebuild
# GET /vps/* includes available-image and IP/datacenter reads.
# Scope /vps/* to your existing VPS's service name.
# Ordering, payment, and termination rights are not needed.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Cloudflare: https://dash.cloudflare.com/profile/api-tokens > Create Token > Custom token.
# Grant Zone > DNS > Edit and Zone > Zone Settings > Edit, scoped to the app's zone.
CLOUDFLARE_API_TOKEN=

# Copy to terraform.tfvars and choose values from your accounts.
# Create a dedicated VPS first; the initial IaC apply reinstalls it and erases its data.
vps_service_name   = "vps-123456.ovh.net"
# GET /vps/{serviceName}/images/available, then GET /vps/{serviceName}/images/available/{id}.
# Select Debian 13; the API console is https://api.us.ovhcloud.com/console/.
vps_image_id       = ""
cloudflare_zone_id = ""
staging_host       = "staging-api.example.com"
production_host    = "api.example.com"
